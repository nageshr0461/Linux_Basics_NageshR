1. Creating and Renaming Files/Directories
root@ip-172-31-3-29:~# mkdir test_dir
root@ip-172-31-3-29:~# ls
diskfree.txt  first_shellscript.sh  index.html  snap  sudoers  test_dir
root@ip-172-31-3-29:~# touch test_dir/example.txt
root@ip-172-31-3-29:~# ls -l test_dir/
total 0
-rw-r--r-- 1 root root 0 Sep 29 11:52 example.txt
root@ip-172-31-3-29:~# mv test_dir/example.txt renamed_example.txt
root@ip-172-31-3-29:~# ls
diskfree.txt  first_shellscript.sh  index.html  renamed_example.txt  snap  sudoers  test_dir
root@ip-172-31-3-29:~# ls -ltr test_dir/
total 0
root@ip-172-31-3-29:~# cd test_dir/
root@ip-172-31-3-29:~/test_dir# ls
root@ip-172-31-3-29:~/test_dir# cd ..
root@ip-172-31-3-29:~# ls
diskfree.txt  first_shellscript.sh  index.html  renamed_example.txt  snap  sudoers  test_dir
root@ip-172-31-3-29:~# mv renamed_example.txt test_dir/
root@ip-172-31-3-29:~# ls
diskfree.txt  first_shellscript.sh  index.html  snap  sudoers  test_dir
